{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "${mod_authors}"
    ],
    "contributors": [
        "${mod_credits}"
    ],
    "contact": {
        "sources": "${mod_url}",
        "issues": "${mod_tracker}"
    },
    "license": "${mod_license}",
    "icon": "${mod_id}.png",
    "environment": "client",
    "entrypoints": {
        "main": [
            "com.aetherteam.cumulus.CumulusFabric"
        ],
        "client": [
            "com.aetherteam.cumulus.CumulusFabric"
        ],
        "fabric-datagen": [
            "com.aetherteam.cumulus.data.CumulusDataGenerator"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.18.4",
        "minecraft": "~1.21.11",
        "java": ">=${java_version}",
        "fabric-api": "*",
        "forgeconfigapiport": "*"
    }
}